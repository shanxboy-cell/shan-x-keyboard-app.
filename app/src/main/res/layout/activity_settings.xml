<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/settingsScroll"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SHAN-X-NOVA"
            android:textColor="#F5F5F7"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keyboard"
            android:textColor="#00C853"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="#9E9EA6"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/settingsSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Search settings: theme, haptic, clipboard..."
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#F5F5F7"
            android:textColorHint="#777780"
            android:background="@drawable/card_bg"
            android:padding="12dp" />

        <!-- Setup card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:padding="20dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="#F5F5F7"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_step1_title"
                android:textColor="#F5F5F7"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/statusEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#9E9EA6" />

            <Button
                android:id="@+id/btnEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_step1_button"
                android:textColor="#0A0A0A"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/setup_step2_title"
                android:textColor="#F5F5F7"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/statusActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#9E9EA6" />

            <Button
                android:id="@+id/btnSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_step2_button"
                android:textColor="#0A0A0A"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_accent" />

            <TextView
                android:id="@+id/setupDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_done"
                android:textColor="#00C853"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="20dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="#F5F5F7"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/heightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings_height"
                android:textColor="#F5F5F7"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_sound"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_haptic"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchHaptic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Premium key animations"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switchAnimation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Large, comfortable keys"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switchLargeKeys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reduced motion"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switchReducedMotion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="High contrast key borders"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switchHighContrast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Premium toolbar"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switchToolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Keep local clipboard history"
                    android:textColor="#F5F5F7"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switchClipboardHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_theme"
                android:textColor="#F5F5F7"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/themeNova"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SHAN-X-NOVA Black"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeMidnight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Midnight Green"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeAmoled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AMOLED Black"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeCarbon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Carbon"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeAurora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aurora"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeGlass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Glass"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeNeon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Neon"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Light Premium"
                    android:textColor="#F5F5F7"
                    android:buttonTint="#00C853" />
            </RadioGroup>

            <Button
                android:id="@+id/btnCustomTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Create custom theme"
                android:textColor="#0A0A0A"
                android:background="@drawable/btn_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_language"
                android:textColor="#F5F5F7"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_language_desc"
                android:textColor="#9E9EA6"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPrivacyCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Privacy Center"
            android:textColor="#0A0A0A"
            android:background="@drawable/btn_accent" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="About SHAN-X-NOVA"
            android:textColor="#0A0A0A"
            android:background="@drawable/btn_accent" />

        <!-- Privacy note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp"
            android:background="@drawable/card_bg"
            android:text="@string/privacy_note"
            android:textColor="#9E9EA6"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:text="SHAN · SHAN-X-NOVA Keyboard 1.0"
            android:textColor="#4A4A52"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
