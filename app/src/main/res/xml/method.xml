<?xml version="1.0" encoding="utf-8"?>
<!-- IME declaration for SHAN-X-NOVA Keyboard -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.shanova.keyboard.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:label="@string/subtype_en"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <subtype
        android:label="@string/subtype_si"
        android:imeSubtypeLocale="si_LK"
        android:imeSubtypeMode="keyboard" />

    <subtype
        android:label="@string/subtype_ta"
        android:imeSubtypeLocale="ta_IN"
        android:imeSubtypeMode="keyboard" />
</input-method>
